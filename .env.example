# Copy this file to .env.local for local browser testing.
# Director's Cut CLI scripts read .env.example, .env, .env.local, and then shell variables.

# Public Supabase project URL. This value is safe to commit.
VITE_SUPABASE_URL=https://ixkkrousepsiorwlaycp.supabase.co
SUPABASE_URL=https://ixkkrousepsiorwlaycp.supabase.co

# Public anon key used by the browser and CLI runner.
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Secret keys. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
FAL_KEY=

# Optional local smoke-test flags. Keep disabled by default.
VITE_BYPASS_AUTH_FOR_TESTS=false
VITE_USE_MOCK_ASSETS=false
